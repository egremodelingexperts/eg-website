<dialog class="lightbox" data-lightbox aria-labelledby="lightbox-caption">
  <div class="lightbox-shell">
    <button class="close" type="button" data-lightbox-close aria-label="Close image viewer">
      <span aria-hidden="true">×</span>
    </button>
    <button
      class="lightbox-arrow previous"
      type="button"
      data-lightbox-previous
      aria-label="Previous image"
    >
      <span aria-hidden="true">←</span>
    </button>
    <figure>
      <img data-lightbox-image src="" alt="" />
      <figcaption id="lightbox-caption" data-lightbox-caption></figcaption>
    </figure>
    <button class="lightbox-arrow next" type="button" data-lightbox-next aria-label="Next image">
      <span aria-hidden="true">→</span>
    </button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const image = dialog?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const caption = dialog?.querySelector<HTMLElement>("[data-lightbox-caption]");
  const allTriggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]"),
  );
  let triggers: HTMLButtonElement[] = [];
  let currentIndex = 0;

  const triggersFor = (selected: HTMLButtonElement) => {
    const scope = selected.closest<HTMLElement>("[data-lightbox-scope]");
    if (!scope) return [selected];

    return Array.from(scope.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]"));
  };

  const showImage = (index: number) => {
    if (!dialog || !image || !caption || triggers.length === 0) return;
    currentIndex = (index + triggers.length) % triggers.length;
    const trigger = triggers[currentIndex];
    const sourceImage = trigger.querySelector<HTMLImageElement>("img");
    if (!sourceImage) return;
    image.src = sourceImage.currentSrc || sourceImage.src;
    image.alt = trigger.dataset.lightboxAlt ?? "";
    caption.textContent = trigger.dataset.lightboxAlt ?? "";
  };

  allTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      if (!dialog) return;
      triggers = triggersFor(trigger);
      showImage(triggers.indexOf(trigger));
      dialog.showModal();
    });
  });

  dialog?.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
  dialog
    ?.querySelector("[data-lightbox-previous]")
    ?.addEventListener("click", () => showImage(currentIndex - 1));
  dialog
    ?.querySelector("[data-lightbox-next]")
    ?.addEventListener("click", () => showImage(currentIndex + 1));

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") showImage(currentIndex - 1);
    if (event.key === "ArrowRight") showImage(currentIndex + 1);
  });
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: none;
    height: 100vh;
    max-height: none;
    border: 0;
    background: rgba(4, 12, 24, 0.96);
    color: white;
    padding: 0;
  }

  .lightbox::backdrop {
    background: rgba(4, 12, 24, 0.92);
  }

  .lightbox-shell {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    padding: 4.5rem clamp(1rem, 5vw, 5rem) 2rem;
  }

  figure {
    display: grid;
    width: min(100%, 1100px);
    height: 100%;
    max-height: calc(100vh - 7rem);
    grid-template-rows: minmax(0, 1fr) auto;
    margin: 0;
  }

  figure img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  figcaption {
    padding-top: 1rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.82rem;
    text-align: center;
  }

  .close,
  .lightbox-arrow {
    position: absolute;
    z-index: 2;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    cursor: pointer;
  }

  .close {
    top: 1rem;
    right: 1rem;
    font-size: 2rem;
  }

  .lightbox-arrow {
    top: 50%;
    transform: translateY(-50%);
  }

  .previous {
    left: 1rem;
  }

  .next {
    right: 1rem;
  }

  @media (max-width: 620px) {
    .lightbox-shell {
      padding-inline: 0.5rem;
    }

    .lightbox-arrow {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
  }
</style>
