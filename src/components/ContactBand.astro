---
import { siteConfig } from "../config/site";
import { withBase } from "../utils/paths";

interface Props {
  title?: string;
  body?: string;
  dark?: boolean;
}

const {
  title = "Ready to Start Your Project?",
  body = "Tell us about your space and the transformation you have in mind. Our team is ready to discuss the possibilities.",
  dark = true,
} = Astro.props;
---

<section class:list={["contact-band", dark && "dark"]}>
  <div class="container">
    <span class="eyebrow">Get Started</span>
    <h2 class="heading">{title}</h2>
    <p>{body}</p>
    <div class="actions">
      <a
        class:list={["button", dark ? "button-bronze" : "button-primary"]}
        href={withBase("/consultation/")}
      >
        Request a Consultation
      </a>
      <a class="button contact-secondary" href={siteConfig.phoneHref}>
        Call {siteConfig.phoneDisplay}
      </a>
      <a class="button contact-secondary" href={`mailto:${siteConfig.email}`}>Email Us</a>
    </div>
  </div>
</section>

<style>
  .contact-band {
    padding-block: clamp(5rem, 9vw, 8rem);
    background: var(--color-paper);
    text-align: center;
  }

  .contact-band.dark {
    background: var(--color-navy);
    color: white;
  }

  h2 {
    max-width: 48rem;
    margin-inline: auto;
  }

  p {
    max-width: 50rem;
    margin: 1.5rem auto 2.25rem;
    color: var(--color-slate);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .dark p {
    color: rgba(255, 255, 255, 0.72);
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .contact-secondary {
    border-color: rgba(10, 25, 47, 0.35);
    color: var(--color-navy);
    background: transparent;
  }

  .dark .contact-secondary {
    border-color: rgba(255, 255, 255, 0.55);
    color: white;
  }

  .dark .contact-secondary:hover {
    background: white;
    color: var(--color-navy);
  }

  @media (max-width: 560px) {
    .actions {
      align-items: stretch;
      flex-direction: column;
      width: min(100%, 22rem);
      margin-inline: auto;
    }
  }
</style>
