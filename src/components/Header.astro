---
import { Image } from "astro:assets";
import logo from "../assets/brand/logo.png";
import { siteConfig } from "../config/site";

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
      <Image
        src={logo}
        alt=""
        width={52}
        height={52}
        class="brand-logo"
        format="webp"
        quality={85}
      />
      <span>{siteConfig.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        siteConfig.navigation.map((item) => (
          <a class:list={[pathname === item.href && "active"]} href={item.href}>
            {item.label}
          </a>
        ))
      }
      <span class="nav-divider" aria-hidden="true"></span>
      <a class="contact-link" href={siteConfig.phoneHref} aria-label={`Call ${siteConfig.phoneDisplay}`}>
        Call
      </a>
      <a class="contact-link" href={`mailto:${siteConfig.email}`} aria-label={`Email ${siteConfig.name}`}>
        Email
      </a>
    </nav>

    <div class="desktop-actions">
      <a class="button button-primary desktop-cta" href="/consultation/"> Request Consultation </a>
    </div>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile navigation">
      <a href="/">Home</a>
      {
        siteConfig.navigation.map((item) => (
          <a class:list={[pathname === item.href && "active"]} href={item.href}>
            {item.label}
          </a>
        ))
      }
      <a class="mobile-cta" href="/consultation/">Request Consultation</a>
      <div class="mobile-direct" aria-label="Direct contact options">
        <a href={siteConfig.phoneHref}>Call</a>
        <a href={`mailto:${siteConfig.email}`}>Email</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Open navigation menu" : "Close navigation menu");
      menu.hidden = isOpen;
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        menu.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Open navigation menu");
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid rgba(10, 25, 47, 0.08);
    background: rgba(253, 253, 251, 0.96);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: grid;
    min-height: 5.5rem;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: clamp(1rem, 2vw, 2.25rem);
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.65rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .brand-logo {
    width: 3.25rem;
    height: 3.25rem;
    object-fit: contain;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 1.6vw, 2rem);
  }

  .desktop-nav a {
    position: relative;
    padding-block: 0.6rem;
    color: var(--color-slate);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-bronze);
    content: "";
    transform: scaleX(0);
    transition: transform 180ms ease;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a.active::after {
    transform: scaleX(1);
  }

  .nav-divider {
    width: 1px;
    height: 1.35rem;
    background: rgba(10, 25, 47, 0.16);
  }

  .desktop-nav .contact-link {
    color: var(--color-bronze);
  }

  .desktop-actions {
    display: flex;
    align-items: center;
  }

  .menu-toggle,
  .mobile-menu {
    display: none;
  }

  @media (max-width: 820px) {
    .header-inner {
      min-height: 4.75rem;
      grid-template-columns: 1fr auto;
    }

    .brand-logo {
      width: 3rem;
      height: 3rem;
    }

    .brand span {
      max-width: 14rem;
      font-size: 1.05rem;
    }

    .desktop-nav,
    .desktop-actions {
      display: none;
    }

    .menu-toggle {
      display: grid;
      width: 3rem;
      height: 3rem;
      place-content: center;
      gap: 5px;
      border: 0;
      background: transparent;
      color: var(--color-navy);
      cursor: pointer;
    }

    .menu-toggle span {
      display: block;
      width: 1.5rem;
      height: 2px;
      background: currentColor;
    }

    .mobile-menu {
      display: block;
      border-top: 1px solid rgba(10, 25, 47, 0.08);
      background: var(--color-warm-white);
    }

    .mobile-menu[hidden] {
      display: none;
    }

    .mobile-menu nav {
      display: grid;
      width: min(100% - 2rem, 1280px);
      margin-inline: auto;
      padding-block: 0.75rem 1.25rem;
    }

    .mobile-menu a {
      border-bottom: 1px solid rgba(10, 25, 47, 0.08);
      padding: 1rem 0.25rem;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .mobile-menu .mobile-cta {
      margin-top: 0.75rem;
      border: 0;
      background: var(--color-navy);
      color: white;
      text-align: center;
    }

    .mobile-direct {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      padding-top: 0.75rem;
    }

    .mobile-menu .mobile-direct a {
      border: 1px solid rgba(10, 25, 47, 0.25);
      padding: 0.8rem;
      text-align: center;
    }
  }

  @media (max-width: 420px) {
    .brand span {
      max-width: 10rem;
    }
  }
</style>
