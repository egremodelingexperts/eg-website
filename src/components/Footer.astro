---
import { Image } from "astro:assets";
import logo from "../assets/brand/logo.png";
import { siteConfig } from "../config/site";

interface Props {
  year: number;
}

const { year } = Astro.props;
---

<footer class="site-footer" id="contact">
  <div class="footer-grid container">
    <div class="footer-brand">
      <a href="/" aria-label={`${siteConfig.name} home`}>
        <Image src={logo} alt="" width={180} height={180} format="webp" quality={82} />
      </a>
      <p>Crafting beautiful and functional spaces from concept to completion.</p>
      <a class="social-link" href={siteConfig.instagram} target="_blank" rel="noreferrer">
        Follow our work on Instagram <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div>
      <h2>Explore</h2>
      <ul>
        <li><a href="/portfolio/">Portfolio</a></li>
        <li><a href="/reviews/">Reviews</a></li>
        <li><a href="/consultation/">Consultation</a></li>
        <li><a href="/privacy/">Privacy Policy</a></li>
      </ul>
    </div>

    <div>
      <h2>Services</h2>
      <ul>
        <li><a href="/portfolio/#kitchens">Kitchen Remodeling</a></li>
        <li><a href="/portfolio/#bathrooms">Bathroom Remodeling</a></li>
        <li><a href="/portfolio/#surfaces">Surfaces &amp; Custom Details</a></li>
      </ul>
    </div>

    <div>
      <h2>Contact</h2>
      <address>
        <a href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a>
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        <span>{siteConfig.location}</span>
        <span>{siteConfig.hours}</span>
      </address>
    </div>
  </div>
  <div class="footer-bottom container">
    <span>© {year} {siteConfig.legalName}. All rights reserved.</span>
    <a href="/privacy/">Privacy Policy</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: rgba(255, 255, 255, 0.76);
    padding: 5rem 0 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.45fr repeat(3, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .footer-brand > a:first-child {
    display: inline-grid;
    width: 8rem;
    height: 8rem;
    margin-bottom: 0.75rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: white;
    padding: 0.25rem;
  }

  .footer-brand img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .footer-brand p {
    max-width: 21rem;
    margin: 0 0 1.25rem;
    line-height: 1.7;
  }

  .site-footer h2 {
    margin: 0 0 1.4rem;
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .site-footer ul {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    transition: color 160ms ease;
  }

  .site-footer a:hover {
    color: var(--color-bronze-light);
  }

  .social-link {
    color: white;
    font-size: 0.83rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  address {
    display: grid;
    gap: 0.8rem;
    font-style: normal;
    line-height: 1.5;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 4.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-top: 1.5rem;
    font-size: 0.78rem;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
