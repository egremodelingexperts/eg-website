---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GalleryCarousel from "../../components/GalleryCarousel.astro";
import Lightbox from "../../components/Lightbox.astro";
import ContactBand from "../../components/ContactBand.astro";
import { galleries } from "../../data/galleries";
import premiumFlooring from "../../assets/images/premium-flooring.jpg";
import livingBuiltins from "../../assets/images/living-builtins.jpg";
import architecturalFireplace from "../../assets/images/architectural-fireplace.jpg";
---

<BaseLayout
  title="Portfolio"
  description="Explore authentic kitchen, bathroom, flooring and custom-detail remodeling projects completed by EG Remodeling Experts."
  canonicalPath="/portfolio/"
>
  <section class="portfolio-intro">
    <div class="container">
      <span class="eyebrow">Authentic Transformations</span>
      <h1 class="display">Our Portfolio</h1>
      <p>
        A gallery of our authentic transformations, from concept to completion. Every detail
        considered, every surface perfected.
      </p>
    </div>
  </section>

  <GalleryCarousel gallery={galleries[0]} />
  <GalleryCarousel gallery={galleries[1]} dark />

  <section class="section details">
    <div class="container">
      <div class="details-heading">
        <span class="eyebrow">03</span>
        <h2 class="heading">Surfaces &amp; Custom Details</h2>
      </div>
      <div class="detail-grid">
        <button type="button" data-lightbox-trigger data-lightbox-alt="Premium Flooring">
          <Image
            src={premiumFlooring}
            alt="Premium Flooring"
            widths={[480, 800]}
            sizes="(min-width: 768px) 33vw, 100vw"
            format="avif"
          />
          <span>Premium Flooring</span>
        </button>
        <button type="button" data-lightbox-trigger data-lightbox-alt="Living Spaces">
          <Image
            src={livingBuiltins}
            alt="Living Spaces"
            widths={[480, 800]}
            sizes="(min-width: 768px) 33vw, 100vw"
            format="avif"
          />
          <span>Living Spaces</span>
        </button>
        <button type="button" data-lightbox-trigger data-lightbox-alt="Architectural Features">
          <Image
            src={architecturalFireplace}
            alt="Architectural Features"
            widths={[480, 800]}
            sizes="(min-width: 768px) 33vw, 100vw"
            format="avif"
          />
          <span>Architectural Features</span>
        </button>
      </div>
      <p class="authenticity">
        All images represent real projects completed by the EG Remodeling Experts team.
      </p>
    </div>
  </section>

  <ContactBand
    dark={false}
    title="Envision Your Space"
    body="Ready to begin your own transformation? Our team is available to discuss the possibilities for your home."
  />
  <Lightbox />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const status = carousel.querySelector<HTMLElement>("[data-status]");
    let current = 0;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        slide.hidden = slideIndex !== current;
      });
      dots.forEach((dot, dotIndex) => {
        dot.setAttribute("aria-current", String(dotIndex === current));
      });
      if (status) status.textContent = `Image ${current + 1} of ${slides.length}`;
    };

    carousel.querySelector("[data-previous]")?.addEventListener("click", () => show(current - 1));
    carousel.querySelector("[data-next]")?.addEventListener("click", () => show(current + 1));
    dots.forEach((dot, index) => dot.addEventListener("click", () => show(index)));
    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(current - 1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        show(current + 1);
      }
    });
  });
</script>

<style>
  .portfolio-intro {
    padding-block: clamp(6rem, 12vw, 10rem) clamp(3rem, 6vw, 5rem);
    text-align: center;
  }

  .portfolio-intro p {
    max-width: 56rem;
    margin: 2rem auto 0;
    color: var(--color-slate);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  .details-heading {
    margin-bottom: 3rem;
    border-bottom: 1px solid rgba(10, 25, 47, 0.15);
    padding-bottom: 1.5rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
    gap: 2.25rem;
  }

  .detail-grid button {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--color-navy);
    cursor: zoom-in;
    text-align: left;
  }

  .detail-grid button:nth-child(2) {
    margin-top: 4rem;
  }

  .detail-grid img {
    width: 100%;
    height: 21rem;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .detail-grid button:hover img {
    transform: translateY(-4px);
  }

  .detail-grid span {
    display: block;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.5vw, 2rem);
  }

  .authenticity {
    margin: 5rem auto 0;
    color: var(--color-slate);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-align: center;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }

    .detail-grid button:nth-child(2) {
      margin-top: 0;
    }
  }
</style>
